DOMAIN=yourdomain.com
SERVER_IP=0.0.0.0
PORT=5000

# Second app sharing this nginx (FiyavalhuMV web UI) - leave unset until that
# app actually exists; nginx will just fail health checks for requests to
# this domain in the meantime, with zero effect on the DOMAIN above.
FIYAVALHU_DOMAIN=finance.yourdomain.com
